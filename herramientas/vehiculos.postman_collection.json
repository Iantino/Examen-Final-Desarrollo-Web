{
  "info": {
    "name": "Serie 4 - Vehículos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "vehiculo_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2024,\n  \"color\": \"Blanco\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"vehiculo_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista JSON\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consultar ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/{{vehiculo_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Actualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/{{vehiculo_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2024,\n  \"color\": \"Azul\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Color actualizado\", () => pm.expect(pm.response.json().color).to.eql(\"Azul\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Validación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marca\": \"\",\n  \"anio\": 1800\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Errores por campo\", () => pm.expect(pm.response.json()).to.have.all.keys(\"marca\", \"modelo\", \"anio\", \"color\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Eliminar",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/vehiculos/{{vehiculo_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}